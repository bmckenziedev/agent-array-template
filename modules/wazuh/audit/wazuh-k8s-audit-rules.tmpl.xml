<group name="k8s_audit,agent_array,">
  <rule id="100800" level="0">
    <decoded_as>json</decoded_as>
    <field name="apiVersion" type="pcre2">^audit\.k8s\.io/v1$</field>
    <field name="kind" type="pcre2">^Event$</field>
    <description>Kubernetes API audit event</description>
  </rule>
  <rule id="100802" level="8">
    <if_sid>100800</if_sid>
    <field name="objectRef.subresource" type="pcre2">^(exec|attach|portforward)$</field>
    <field name="stage" type="pcre2">^ResponseStarted$</field>
    <description>k8s audit: $(user.username) opened pods/$(objectRef.subresource) into $(objectRef.namespace)/$(objectRef.name)</description>
    <group>k8s_interactive,
  </group>
  </rule>
  <rule id="100801" level="0">
    <if_sid>100800</if_sid>
    <field name="stage" type="pcre2">^(ResponseComplete|Panic)$</field>
    <description>Kubernetes API audit event (completed request)</description>
  </rule>
  <rule id="100803" level="10">
    <if_sid>100801</if_sid>
    <field name="objectRef.apiGroup" type="pcre2">^rbac\.authorization\.k8s\.io$</field>
    <field name="verb" type="pcre2">^(create|update|patch|delete|deletecollection)$</field>
    <description>k8s audit: RBAC change by $(user.username): $(verb) $(objectRef.resource) $(objectRef.namespace)/$(objectRef.name)</description>
    <group>k8s_rbac,
  </group>
  </rule>
  <rule id="100804" level="10">
    <if_sid>100801</if_sid>
    <field name="objectRef.apiGroup" type="pcre2">^admissionregistration\.k8s\.io$</field>
    <field name="verb" type="pcre2">^(create|update|patch|delete|deletecollection)$</field>
    <description>k8s audit: admission control change by $(user.username): $(verb) $(objectRef.resource) $(objectRef.name)</description>
    <group>k8s_admission,
  </group>
  </rule>
  <rule id="100805" level="8">
    <if_sid>100801</if_sid>
    <field name="objectRef.resource" type="pcre2">^networkpolicies$</field>
    <field name="verb" type="pcre2">^(create|update|patch|delete|deletecollection)$</field>
    <description>k8s audit: NetworkPolicy change by $(user.username): $(verb) $(objectRef.namespace)/$(objectRef.name)</description>
    <group>k8s_netpol,
  </group>
  </rule>
  <rule id="100806" level="7">
    <if_sid>100801</if_sid>
    <field name="objectRef.resource" type="pcre2">^secrets$</field>
    <field name="verb" type="pcre2">^(get|list|watch)$</field>
    <field name="user.username" type="pcre2" negate="yes">^system:(serviceaccount:|node:|kube-|k3s-|apiserver$|cloud-controller-manager$)</field>
    <description>k8s audit: Secret read by $(user.username): $(verb) $(objectRef.namespace)/$(objectRef.name)</description>
    <group>k8s_secret_read,
  </group>
  </rule>
  <rule id="100807" level="5">
    <if_sid>100801</if_sid>
    <field name="responseStatus.code" type="pcre2">^(401|403)$</field>
    <field name="user.username" type="pcre2" negate="yes">^system:(serviceaccount:|node:|kube-|k3s-|apiserver$|cloud-controller-manager$)</field>
    <description>k8s audit: request denied for $(user.username): $(verb) $(objectRef.resource) $(objectRef.namespace)/$(objectRef.name)</description>
    <group>k8s_denied,
  </group>
  </rule>
  <rule id="100808" level="3">
    <if_sid>100801</if_sid>
    <field name="verb" type="pcre2">^(create|update|patch|delete|deletecollection)$</field>
    <field name="user.username" type="pcre2" negate="yes">^system:(serviceaccount:|node:|kube-|k3s-|apiserver$|cloud-controller-manager$)</field>
    <description>k8s audit: API write by $(user.username): $(verb) $(objectRef.resource) $(objectRef.namespace)/$(objectRef.name)</description>
    <group>k8s_write,
  </group>
  </rule>
  <rule id="100809" level="10">
    <if_sid>100802</if_sid>
    <field name="objectRef.namespace" type="pcre2">^{{USER_NS_PREFIX}}</field>
    <field name="objectRef.subresource" type="pcre2">^(exec|attach)$</field>
    <description>User session interactive access by $(user.username)</description>
    <group>user_session_access,</group>
  </rule>
  <rule id="100810" level="12">
    <if_sid>100800</if_sid>
    <field name="user.groups" type="pcre2">(?:^|[\s,\["]){{OIDC_GROUP_BREAKGLASS}}(?:$|[\s,\]"])</field>
    <field name="stage" type="pcre2">^(ResponseStarted|ResponseComplete)$</field>
    <description>Break-glass identity used by $(user.username)</description>
    <group>breakglass,</group>
  </rule>
  <rule id="100811" level="12">
    <if_sid>100800</if_sid>
    <field name="annotations.{{LABEL_PREFIX}}/breakglass-ticket" type="pcre2">.+</field>
    <field name="stage" type="pcre2">^(ResponseStarted|ResponseComplete)$</field>
    <description>Break-glass ticket attached to API access by $(user.username)</description>
    <group>breakglass,</group>
  </rule>
</group>
