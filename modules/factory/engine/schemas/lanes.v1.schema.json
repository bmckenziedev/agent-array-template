{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-array.local/factory/lanes.v1.schema.json",
  "title": "Factory lanes + routing config v1",
  "description": "Overlay on the engine defaults (factory_engine/config.py DEFAULT_LANES). One lane per GPU model server, each with an asyncio semaphore of `concurrency`. Keys are read from key_file or key_env at request time and are never logged.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_doc": {
      "type": "string"
    },
    "replace_lanes": {
      "type": "boolean"
    },
    "lanes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,40}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gpu": {
            "type": "string",
            "maxLength": 80
          },
          "tier": {
            "type": "string",
            "maxLength": 20
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "ctx": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 262144
          },
          "prompt_cap": {
            "type": "integer",
            "minimum": 512,
            "maximum": 262144
          },
          "endpoint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "base_url": {
                "type": "string",
                "pattern": "^https?://[^\\s/@]+(:[0-9]+)?(/[^\\s]*)?$"
              },
              "api": {
                "enum": [
                  "openai-completions",
                  "openai-chat",
                  "llamacpp"
                ]
              },
              "model": {
                "type": "string",
                "maxLength": 200
              },
              "template": {
                "enum": [
                  "chatml",
                  "chatml-nothink",
                  "none"
                ]
              },
              "key_file": {
                "type": "string",
                "maxLength": 400
              },
              "key_env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 5,
                "maximum": 1800
              },
              "accept_unknown_stop": {
                "type": "boolean"
              },
              "extra": {
                "type": "object"
              }
            }
          },
          "local": {
            "type": "boolean"
          },
          "node": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "doc_map",
          "test_gen"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "easy",
            "normal"
          ]
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "lane"
            ],
            "additionalProperties": false,
            "properties": {
              "lane": {
                "type": "string",
                "maxLength": 41
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "top_p": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "top_k": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "min_p": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "repetition_penalty": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              },
              "presence_penalty": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "feedback": {
                "type": "boolean"
              },
              "steal_to": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "maxLength": 41
                }
              }
            }
          }
        }
      }
    },
    "steal": {
      "type": "boolean"
    },
    "gate_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "infra_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "pause_bounce_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pause_min_done": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_inflight_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    }
  }
}
