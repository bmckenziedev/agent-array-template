{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-array.local/factory/profile.v1.schema.json",
  "title": "Factory repo profile v1",
  "description": "Per-repo profile written once by the frontier (corrected plan, phase 1): language/style notes for the prompt, the doc rules, the tsc --checkJs scope, and for test_gen the test profile (dummy env, standard mocks, --forceExit, timeouts). Support files are embedded so a gate request is self-contained.",
  "type": "object",
  "required": [
    "profile"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": 1
    },
    "repo": {
      "type": "string",
      "maxLength": 100
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "language": {
      "type": "string",
      "maxLength": 400
    },
    "style": {
      "type": "string",
      "maxLength": 1200
    },
    "prompt_notes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 600
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "exemplar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 400
        },
        "text": {
          "type": "string",
          "maxLength": 6000
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAnyFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxBlockChars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 20000
        }
      }
    },
    "tsc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "exclude": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "compilerOptions": {
          "type": "object"
        },
        "timeoutS": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        }
      }
    },
    "jest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseJestConfig": {
          "type": "string",
          "maxLength": 200
        },
        "setupFiles": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "moduleNameMapper": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 400
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 400
          }
        },
        "allowedPackages": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "testTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "timeoutS": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "mutantParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "prompt_notes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 600
          }
        },
        "exemplar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "maxLength": 400
            },
            "text": {
              "type": "string",
              "maxLength": 6000
            }
          }
        }
      }
    }
  }
}
