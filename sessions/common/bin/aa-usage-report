#!/usr/bin/env python3
"""Send seat window numbers to pace. Never send rollout events or transcript text.

Exit 0 on success, 1 on configuration/HTTP error, 2 on invalid CLI arguments.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
import time
import urllib.request
from pathlib import Path


def percentage(value) -> float:
    if isinstance(value, bool):
        raise ValueError("percentage must be numeric")
    result = float(value)
    if not math.isfinite(result) or not 0 <= result <= 100:
        raise ValueError("percentage must be finite and between 0 and 100")
    return result


def manual(value: str) -> list[dict]:
    result = []
    names = set()
    for item in value.split(","):
        name, pct = item.split("=", 1)
        if not re.fullmatch(r"[a-zA-Z0-9_-]+", name) or name in names:
            raise ValueError("invalid or duplicate window")
        names.add(name)
        result.append({"window": name, "used_pct": percentage(pct),
                       "resets_at": None, "source": "manual"})
    return result


def rate_limits(value):
    if isinstance(value, dict):
        if isinstance(value.get("rate_limits"), dict):
            yield value["rate_limits"]
        for child in value.values():
            yield from rate_limits(child)
    elif isinstance(value, list):
        for child in value:
            yield from rate_limits(child)


def readings(limits: dict) -> list[dict]:
    result = []
    for key in ("primary", "secondary"):
        window = limits.get(key)
        if not isinstance(window, dict) or "used_percent" not in window:
            continue
        minutes = window.get("window_minutes", 10080 if key == "secondary" else 300)
        if isinstance(minutes, bool) or not isinstance(minutes, (float, int)) or minutes <= 0:
            continue
        name = "weekly" if minutes >= 10080 else "5h" if minutes == 300 else f"{int(minutes)}m"
        reset = window.get("resets_at")
        # Numbers only: even a forged field cannot smuggle transcript text out.
        if reset is not None and (isinstance(reset, bool) or not isinstance(reset, (int, float))
                                  or not math.isfinite(reset)):
            continue
        try:
            pct = percentage(window["used_percent"])
        except (ValueError, TypeError):
            continue
        result.append({"window": name, "used_pct": pct, "resets_at": reset,
                       "source": "codex-rollout"})
    return result


def codex_readings(sessions: Path) -> list[dict]:
    paths = []
    for path in sessions.glob("**/rollout-*.jsonl"):
        if path.is_symlink() or not path.is_file():
            continue
        if not path.resolve().is_relative_to(sessions.resolve()):
            continue
        paths.append((path.stat().st_mtime_ns, str(path), path))
    for _, _, path in sorted(paths, reverse=True)[:50]:
        latest = []
        with path.open(encoding="utf-8") as stream:
            for line in stream:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                for limits in rate_limits(event):
                    candidate = readings(limits)
                    if candidate:
                        latest = candidate
        if latest:
            return latest
    return []


def post(reading: dict) -> None:
    account = os.environ.get("AA_ACCOUNT", "")
    url = os.environ.get("AA_PACE_URL", "")
    if not account or not url:
        raise ValueError("AA_ACCOUNT and AA_PACE_URL are required")
    token = Path(os.environ.get("AA_PACE_TOKEN_FILE", "/var/run/agent-array/pace-token/token")).read_text().strip()
    if not token:
        raise ValueError("pace pod token unavailable")
    payload = {"account_id": account, **reading}
    request = urllib.request.Request(url.rstrip("/") + "/v1/usage", method="POST",
                                     data=json.dumps(payload, allow_nan=False).encode(),
                                     headers={"Content-Type": "application/json", "Authorization": "Bearer " + token})
    with urllib.request.urlopen(request, timeout=10) as response:
        if response.status != 204:
            raise ValueError("pace usage response must be 204")


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manual")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true")
    mode.add_argument("--loop", type=int, metavar="SECONDS")
    args = parser.parse_args(argv)
    if args.loop is not None and args.loop < 1:
        parser.error("--loop must be positive")
    try:
        fixed = manual(args.manual) if args.manual else None
    except (ValueError, TypeError) as exc:
        parser.error(str(exc))
    while True:
        try:
            values = fixed if fixed is not None else codex_readings(
                Path(os.environ.get("CODEX_HOME", "/home/codex/.codex")) / "sessions")
            for reading in values:
                post(reading)
        except (OSError, ValueError) as exc:
            # HTTP errors may carry response payloads; avoid printing them.
            print(f"aa-usage-report: failed ({type(exc).__name__})", file=sys.stderr)
            if not args.loop:
                return 1
        if not args.loop:
            return 0
        time.sleep(args.loop)


if __name__ == "__main__":
    sys.exit(main())
