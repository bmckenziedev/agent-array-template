#!/usr/bin/env python3
"""Fail-closed image preflight. Exit 0 on success, 1 on a refused configuration."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys

RISKY = {
    "NODE_OPTIONS", "NODE_EXTRA_CA_CERTS", "NODE_TLS_REJECT_UNAUTHORIZED",
    "SSL_CERT_FILE", "SSL_CERT_DIR", "BUN_OPTIONS", "BUN_CONFIG_FILE",
    "LD_PRELOAD", "LD_LIBRARY_PATH", "LD_AUDIT", "BASH_ENV", "ENV",
    "OPENSSL_CONF", "OPENSSL_MODULES", "OPENSSL_ENGINES", "SHELLOPTS",
    "BASHOPTS", "PS4", "DISABLE_GROWTHBOOK", "DISABLE_TELEMETRY", "DO_NOT_TRACK",
}
KIMI_ALLOWED = {
    "KIMI_CODE_HOME", "KIMI_DISABLE_TELEMETRY", "KIMI_CODE_NO_AUTO_UPDATE",
    "KIMI_DISABLE_CRON", "KIMI_CODE_MODEL_CATALOG_REFRESH_ON_START",
    "KIMI_CODE_MODEL_CATALOG_REFRESH_INTERVAL_MS", "KIMI_CODE_WATCH",
    "KIMI_CODE_BACKGROUND_KEEP_ALIVE_ON_EXIT",
}


def verify_env(tool: str) -> None:
    bad = []
    for name in os.environ:
        vendor = name.startswith(("ANTHROPIC_", "CLAUDE", "CODEX_", "OPENAI_", "MOONSHOT_", "KIMI_"))
        allowed = name in {"CLAUDE_CONFIG_DIR", "CODEX_HOME"} | KIMI_ALLOWED
        if name in RISKY or name.startswith(("BASH_FUNC_", "LD_", "PYTHON")) or (vendor and not allowed):
            bad.append(name)
    if bad:
        raise ValueError("refusing environment variables: " + ", ".join(sorted(bad)))
    if tool == "kimi":
        for name in ("KIMI_DISABLE_TELEMETRY", "KIMI_CODE_NO_AUTO_UPDATE", "KIMI_DISABLE_CRON"):
            if os.environ.get(name) not in {"1", "true"}:
                raise ValueError(name + " must be 1")
        for name in ("KIMI_CODE_MODEL_CATALOG_REFRESH_ON_START", "KIMI_CODE_MODEL_CATALOG_REFRESH_INTERVAL_MS", "KIMI_CODE_WATCH"):
            if os.environ.get(name) not in {"0", "false"}:
                raise ValueError(name + " must be 0")
        proxy = os.environ.get("HTTPS_PROXY")
        if not proxy or proxy != os.environ.get("AA_KIMI_EGRESS_PROXY"):
            raise ValueError("HTTPS_PROXY must equal the configured exact-host Kimi gateway")
        if os.environ.get("NO_PROXY", "127.0.0.1,localhost") != "127.0.0.1,localhost":
            raise ValueError("NO_PROXY must be loopback only")
        if any(name in os.environ for name in ("HTTP_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy", "NODE_USE_ENV_PROXY")):
            raise ValueError("alternative proxy environment refused")


def verify_hash(directory: Path, tool: str) -> None:
    manifest = directory / ".rendered.sha256"
    text = manifest.read_text(encoding="utf-8")
    if text.lstrip().startswith("{"):
        hashes = json.loads(text)
    else:
        hashes = {}
        for line in text.splitlines():
            digest, name = line.split(maxsplit=1)
            hashes[name.lstrip(" *")] = digest
    required = {"claude": {"managed-settings.json"},
                "codex": {"requirements.toml", "managed_config.toml"},
                "kimi": {"policy.toml"}}[tool]
    if not isinstance(hashes, dict) or not required <= hashes.keys():
        raise ValueError("policy hash manifest omits mandatory policy files")
    for name, digest in hashes.items():
        if Path(name).name != name or not re.fullmatch(r"[0-9a-f]{64}", str(digest)):
            raise ValueError("invalid policy hash manifest entry")
        if hashlib.sha256((directory / name).read_bytes()).hexdigest() != digest:
            raise ValueError("policy hash mismatch: " + name)
    extra = {p.name for p in directory.iterdir() if p.is_file() and p.name != ".rendered.sha256"} - hashes.keys()
    if extra:
        raise ValueError("unhashed managed files: " + ", ".join(sorted(extra)))


def filesystem(path: Path) -> str:
    best = (0, "unknown", "")
    for line in Path("/proc/mounts").read_text().splitlines():
        device, mount, kind, *_ = line.split()
        mount = mount.replace("\\040", " ")
        if str(path) == mount or str(path).startswith(mount.rstrip("/") + "/"):
            if len(mount) >= best[0]:
                best = (len(mount), kind, mount)
    # A disk login must be a dedicated volume, not the image overlay.
    if best[2] == "/":
        return "rootfs"
    return best[1]


def verify_login(path: Path) -> None:
    if path.is_symlink() or not path.is_dir():
        raise ValueError("login directory must exist and must not be a symlink")
    info = path.stat()
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError("login directory must be owned by the pod uid with mode 0700")
    kind = filesystem(path.resolve())
    wanted = os.environ.get("AA_LOGIN_STORAGE", "disk")
    if wanted == "tmpfs":
        ok = kind == "tmpfs"
    elif wanted == "disk":
        ok = kind in {"virtiofs", "9p", "ext4", "xfs", "btrfs"}
    else:
        raise ValueError("AA_LOGIN_STORAGE must be disk or tmpfs")
    if not ok:
        raise ValueError(f"login storage must be {wanted}; observed {kind}")


def verify_mcp(work: Path, home: Path) -> None:
    paths = [work / ".mcp.json", work / ".claude" / "settings.local.json",
             work / ".kimi-code" / "mcp.json", home / "mcp.json"]
    paths.extend(work.glob("*/.mcp.json"))
    for path in paths:
        if path.exists() or path.is_symlink():
            raise ValueError(f"unrendered MCP/configuration file refused: {path}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tool", choices=("claude", "codex", "kimi"), required=True)
    args = parser.parse_args(argv)
    try:
        verify_env(args.tool)
        defaults = {"claude": "/etc/claude-code", "codex": "/etc/codex", "kimi": "/etc/kimi"}
        verify_hash(Path(os.environ.get("AA_POLICY_DIR", defaults[args.tool])), args.tool)
        env = {"claude": "CLAUDE_CONFIG_DIR", "codex": "CODEX_HOME", "kimi": "KIMI_CODE_HOME"}[args.tool]
        home = Path(os.environ[env])
        verify_login(home)
        verify_mcp(Path(os.environ.get("AA_WORK_DIR", "/work")), home)
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(f"aa: preflight refused: {exc}", file=sys.stderr)
        return 1
    print("aa: preflight OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
