#!/usr/bin/env python3
"""Read a per-user forge credential only for the registry-selected HTTPS forge."""
import os
from pathlib import Path
import sys


def main():
    if sys.argv[1:] != ["get"]:
        return 0
    request = {}
    for line in sys.stdin:
        if not line.strip():
            break
        key, _, value = line.rstrip("\n").partition("=")
        request[key] = value
    host = {"github": "github.com", "gitlab": "gitlab.com"}.get(os.environ.get("AA_GIT_PROVIDER"))
    if not host or request.get("protocol") != "https" or request.get("host") != host:
        return 0
    username = os.environ.get("AA_GIT_USERNAME", "")
    if not username or request.get("username", username) != username:
        return 0
    try:
        token = Path("/var/run/agent-array/git-credential/token").read_text().strip()
    except OSError:
        return 1
    if not token or any(c.isspace() for c in token):
        return 1
    print("username=" + username)
    print("password=" + token)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
